# ─────────────────────────────────────────────────────────────────────────────
# push_manager push server: configuration
# Copy to .env and fill in:  cp .env.example .env
# Never commit .env or your keys. Never ship any of these values in the app,
# except CLIENT_API_KEY (which is designed to be public-ish, see below).
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
# Port the server listens on (inside and, with docker compose, outside the container).
PORT=8080
# Interface to listen on inside the container. Keep 0.0.0.0 for Docker.
HOST=0.0.0.0
# docker compose only: host interface the port is published on.
# 0.0.0.0 = reachable from your LAN (needed for a physical test phone),
# 127.0.0.1 = only this machine (use this behind your own reverse proxy).
BIND_ADDRESS=0.0.0.0
# debug | info | warn | error. Titles, bodies and full tokens are never logged.
LOG_LEVEL=info
# Set to true when running behind a reverse proxy, so rate limits use X-Forwarded-For.
# (docker-compose.https.yml sets this for you.)
TRUST_PROXY=false

# ── HTTPS with the bundled Caddy (docker-compose.https.yml only) ────────────
# Public domain whose DNS points to this server. Caddy gets a Let's Encrypt cert for it.
DOMAIN=push.example.com
# E-mail for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com
# Uncomment to make "docker compose up -d" always include Caddy:
#COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml

# ── API keys ────────────────────────────────────────────────────────────────
# Generate each with:  openssl rand -base64 32   (or: npm run gen-key)
#
# ADMIN_API_KEY (required): full access. Only for your own backend / scripts.
# NEVER put it in the app.
ADMIN_API_KEY=change-me
#
# CLIENT_API_KEY (optional): the key the Flutter app uses. Anything in an app can
# be extracted, so this key can only register/remove device tokens, and send
# only if ALLOW_CLIENT_SEND=true. Leave empty to disable app access entirely.
CLIENT_API_KEY=
#
# Allow the app (CLIENT_API_KEY) to call POST /v1/send (by userId only).
# Anyone who extracts the client key can then push to any userId, rate limited.
# Prefer sending from your backend with ADMIN_API_KEY.
ALLOW_CLIENT_SEND=false
# Max client sends per minute per sender (per user with JWT, otherwise per IP).
CLIENT_SEND_RATE_LIMIT=30

# ── Optional: verify the app user's JWT (recommended with CLIENT_API_KEY) ──
# When set, every request with CLIENT_API_KEY must carry the signed-in user's
# JWT in the X-User-Token header. Clients can then only register/remove tokens
# for their own user id (taken from the JWT), and rate limits apply per user.
# Use exactly ONE of JWT_SECRET (HS256/384/512 shared secret) or JWT_JWKS_URL.
JWT_SECRET=
# Examples:
#   Supabase:      https://<project>.supabase.co/auth/v1/.well-known/jwks.json
#   Firebase Auth: https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
#   Auth0:         https://<tenant>.auth0.com/.well-known/jwks.json
JWT_JWKS_URL=
# Optional checks on the JWT (recommended): expected "iss" and "aud".
JWT_ISSUER=
JWT_AUDIENCE=
# Claim that contains the user id (default: sub).
JWT_USER_CLAIM=sub

# ── Token store ─────────────────────────────────────────────────────────────
# sqlite: the server keeps userId → device tokens (needed for HttpSendHandler and
#         POST /v1/send with "userId").
# none:   pure relay, you always send explicit tokens.
TOKEN_STORE=sqlite
# SQLite file. In Docker this is fixed to /data/push.db (a named volume).
DATABASE_PATH=./data/push.db

# ── APNs (iOS) ──────────────────────────────────────────────────────────────
# From developer.apple.com → Certificates, IDs & Profiles → Keys (see README).
# Leave all APNS_* empty to disable iOS.
#
# The .p8 key, EITHER as a path (Docker: put the file in ./secrets) …
# e.g. /secrets/AuthKey_ABC123DEFG.p8
APNS_KEY_PATH=
# … OR inline (\n for line breaks, or the whole file base64-encoded):
#APNS_KEY=-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----
# 10-character Key ID (shown next to the key, also in the file name).
# e.g. ABC123DEFG
APNS_KEY_ID=
# 10-character Team ID (top right in the developer portal / Membership details).
# e.g. TEAM123456
APNS_TEAM_ID=
# Your app's bundle identifier (the APNs "topic").
# e.g. com.example.myapp
APNS_BUNDLE_ID=
# Default APNs environment for tokens that don't say which one they belong to.
# sandbox:    debug builds from Xcode, iOS Simulator
# production: TestFlight and App Store builds
# The plugin sends the right environment per token, and on BadDeviceToken the
# server automatically retries the other environment once.
APNS_ENVIRONMENT=sandbox

# ── FCM (Android) ───────────────────────────────────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private key.
# Leave empty to disable Android.
#
# EITHER a path (Docker: put the file in ./secrets) …
# e.g. /secrets/service-account.json
FCM_SERVICE_ACCOUNT_PATH=
# … OR the JSON inline (single line) or base64-encoded:
#FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}
# Optional, defaults to project_id from the service account.
FCM_PROJECT_ID=
# Android notification channel. The plugin creates "erohub_default".
FCM_ANDROID_CHANNEL_ID=erohub_default

# ── Limits ──────────────────────────────────────────────────────────────────
# Max request body size in bytes.
MAX_BODY_BYTES=65536
